# ==========================================
# Database — shared by NestJS backend and Langfuse
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=rag_database_dev

# Pre-encode special chars in password: @ → %40, # → %23, etc.
# Host = "postgres" (Docker service name) for Docker Compose;
# use "localhost" for local dev outside containers.
DATABASE_URL=postgresql://admin:your_secure_postgres_password@postgres:5432/rag_database_dev

# ==========================================
# Langfuse security
# Generate random strings: openssl rand -base64 32
# ==========================================
NEXTAUTH_SECRET=your_super_secret_key
SALT=your_salt
# NEXTAUTH_URL=http://localhost:3000

# ==========================================
# LLM — all calls route through OpenRouter
# ==========================================
# Single key for embeddings, generation, and routing.
# OpenRouter proxies free models AND OpenAI models (use 'openai/gpt-4o' etc. to switch).
OPENROUTER_API_KEY=sk-or-v1-your-key

# Embedding model. Switch to 'openai/text-embedding-3-small' to use OpenAI via OpenRouter.
# IMPORTANT: EMBEDDING_DIMENSIONS must match the model's output size.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Must match the vector() column type in document_chunks.
# Verify nvidia model dims with: curl /v1/embeddings + python3 -c "print(len(...))"
# openai/text-embedding-3-small → 1536
EMBEDDING_DIMENSIONS=2048

# Generation model (M3, not yet implemented). Switch to 'openai/gpt-4o' for OpenAI.
GENERATOR_MODEL=deepseek/deepseek-r1:free

# Routing/classification model (M3, not yet implemented). Switch to 'openai/gpt-4o-mini'.
ROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ==========================================
# Observability
# ==========================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# ==========================================
# Frontend / CORS
# ==========================================
# NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3001

# ==========================================
# pgadmin — dev-only (docker compose --profile dev up)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
