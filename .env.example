# ==========================================
# Database — shared by NestJS backend and Langfuse
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=rag_database

# Pre-encode special chars in password: @ → %40, # → %23, etc.
# Host = "postgres" (Docker service name) for Docker Compose;
# use "localhost" for local dev outside containers.
DATABASE_URL=postgresql://admin:your_secure_postgres_password@postgres:5432/rag_database

# ==========================================
# Langfuse security
# Generate random strings: openssl rand -base64 32
# ==========================================
NEXTAUTH_SECRET=your_super_secret_key
SALT=your_salt
# NEXTAUTH_URL=http://localhost:3000

# ==========================================
# External API keys
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# ==========================================
# Frontend / CORS
# ==========================================
# NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3001

# ==========================================
# pgadmin — dev-only (docker compose --profile dev up)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
